#!/usr/bin/env node
// Fake `grim` for tests: records its arguments and writes a tiny valid-looking JPEG (64x48) to stdout. It NEVER captures the
// real screen, so the suite can run the screen preview without reading anyone's desktop.
const fs = require('fs');
fs.appendFileSync(`${process.env.ZENVY_FAKE_DIR}/grim.calls`, process.argv.slice(2).join(' ') + '\n');
const n = Number(fs.existsSync(`${process.env.ZENVY_FAKE_DIR}/grim.count`) ? fs.readFileSync(`${process.env.ZENVY_FAKE_DIR}/grim.count`) : 0) + 1;
fs.writeFileSync(`${process.env.ZENVY_FAKE_DIR}/grim.count`, String(n));
process.stdout.write(Buffer.from([0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0, 1, 1, 0, 0, 1, 0, 1, 0, 0,
  0xff, 0xc0, 0x00, 0x11, 0x08, 0x00, 48, 0x00, 64, 0x03, 1, 0x22, 0, 2, 0x11, 1, 3, 0x11, 1, n & 255, 0xff, 0xd9]));
