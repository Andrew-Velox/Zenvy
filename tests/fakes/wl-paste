#!/usr/bin/env node
// Fake `wl-paste`: the "clipboard" is a file in the fake dir. Never touches the real clipboard.
const fs = require('fs'); const d = process.env.ZENVY_FAKE_DIR; const a = process.argv.slice(2);
if (a.includes('--list-types')) { process.stdout.write(fs.existsSync(`${d}/clip-types`) ? fs.readFileSync(`${d}/clip-types`) : 'text/plain\n'); process.exit(0); }
process.stdout.write(fs.existsSync(`${d}/clip`) ? fs.readFileSync(`${d}/clip`) : '');
